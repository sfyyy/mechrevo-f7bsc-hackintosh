+ * VCN v4.0.2, bases 0x7800 / 0x7e00 dwords) and from the upstream Linux sources that drive
+ * exactly this block: drivers/gpu/drm/amd/amdgpu/vcn_v4_0.c, amdgpu_vcn.{c,h},
+ * include/asic_reg/vcn/vcn_4_0_0_{offset,sh_mask}.h (all MIT).
+ *
+ * Nothing here is discovered at runtime: Phoenix has one VCN instance at a fixed address, and the
+ * register set is fixed. tests/vcn_regs_check.py re-parses the upstream register headers and
+ * compares them with the values below, so a typo cannot survive the test.
+ *
+ * This header is self-contained (stdint + macros only) so both the kext and host tests can use it.
+ */
+#ifndef PHX_VCN_H
+#define PHX_VCN_H
+
+#include <stdint.h>
+
+namespace phx_vcn {
+
+// ---------------------------------------------------------------------------------------------------------------
+// Register block. SOC15 maps VCN instance 0 to dword offsets 0x7800 (segment 0) and 0x7e00 (segment 1); the
+// per-register offsets below already include their segment base (that is what regUVD_*_BASE_IDX selects).
+// ---------------------------------------------------------------------------------------------------------------
+constexpr uint32_t kBase0 = 0x7800u;   // VCN segment 0
+constexpr uint32_t kBase1 = 0x7e00u;   // VCN segment 1
+
+constexpr uint32_t kRegPgfsmConfig     = kBase1 + 0x0000u;   // 0x7e00
+constexpr uint32_t kRegPgfsmStatus     = kBase1 + 0x0001u;   // 0x7e01
+constexpr uint32_t kRegPowerStatus     = kBase1 + 0x0002u;   // 0x7e02
+constexpr uint32_t kRegUvdStatus       = kBase0 + 0x0743u;   // 0x7f43
+constexpr uint32_t kRegVcpuCntl        = kBase0 + 0x0796u;   // 0x7f96
+constexpr uint32_t kRegMastintEn       = kBase1 + 0x00e1u;   // 0x7ee1
+constexpr uint32_t kRegLmiCtrl2        = kBase0 + 0x08aeu;   // 0x80ae
+constexpr uint32_t kRegSoftReset       = kBase0 + 0x0747u;   // 0x7f47
+constexpr uint32_t kRegLmiCtrl         = kBase0 + 0x08b0u;   // 0x80b0
+constexpr uint32_t kRegMpcCntl         = kBase0 + 0x07d4u;   // 0x7fd4
+constexpr uint32_t kRegMpcSetMuxA0     = kBase0 + 0x07d6u;   // 0x7fd6
+constexpr uint32_t kRegMpcSetMuxB0     = kBase0 + 0x07d8u;   // 0x7fd8
+constexpr uint32_t kRegMpcSetMux       = kBase0 + 0x07dau;   // 0x7fda
+constexpr uint32_t kRegLmiVcpuCacheBarLo   = kBase0 + 0x0844u;   // 0x8044
+constexpr uint32_t kRegLmiVcpuCacheBarHi   = kBase0 + 0x0845u;   // 0x8045
+constexpr uint32_t kRegVcpuCacheOffset0    = kBase0 + 0x0780u;   // 0x7f80
+constexpr uint32_t kRegVcpuCacheSize0      = kBase0 + 0x0781u;   // 0x7f81
+constexpr uint32_t kRegLmiVcpuCache1BarLo  = kBase0 + 0x0870u;   // 0x8070
+constexpr uint32_t kRegLmiVcpuCache1BarHi  = kBase0 + 0x0871u;   // 0x8071
+constexpr uint32_t kRegVcpuCacheOffset1    = kBase0 + 0x0782u;   // 0x7f82
+constexpr uint32_t kRegVcpuCacheSize1      = kBase0 + 0x0783u;   // 0x7f83
+constexpr uint32_t kRegLmiVcpuCache2BarLo  = kBase0 + 0x0874u;   // 0x8074
+constexpr uint32_t kRegLmiVcpuCache2BarHi  = kBase0 + 0x0875u;   // 0x8075
+constexpr uint32_t kRegVcpuCacheOffset2    = kBase0 + 0x0784u;   // 0x7f84
+constexpr uint32_t kRegVcpuCacheSize2      = kBase0 + 0x0785u;   // 0x7f85
+constexpr uint32_t kRegLmiVcpuNc0BarLo     = kBase0 + 0x0840u;   // 0x8040
+constexpr uint32_t kRegLmiVcpuNc0BarHi     = kBase0 + 0x0841u;   // 0x8041
+constexpr uint32_t kRegVcpuNoncacheOffset0 = kBase0 + 0x0792u;   // 0x7f92
+constexpr uint32_t kRegVcpuNoncacheSize0   = kBase0 + 0x0793u;   // 0x7f93
+constexpr uint32_t kRegCgcGate          = kBase1 + 0x00c1u;   // 0x7ec1
+constexpr uint32_t kRegCgcCtrl          = kBase1 + 0x00c2u;   // 0x7ec2
+constexpr uint32_t kRegSuvdCgcGate      = kBase1 + 0x00c4u;   // 0x7ec4
+constexpr uint32_t kRegSuvdCgcCtrl      = kBase1 + 0x00c6u;   // 0x7ec6
+constexpr uint32_t kRegScratch1            = kBase1 + 0x0015u;   // 0x7e15: the firmware writes its version here
+constexpr uint32_t kRegDpgLmaCtl          = kBase1 + 0x0011u;   // 0x7e11
+constexpr uint32_t kRegDpgLmaData         = kBase1 + 0x0012u;   // 0x7e12
+constexpr uint32_t kRegDpgLmaMask         = kBase1 + 0x0013u;   // 0x7e13
+constexpr uint32_t kRegGfx10AddrConfig     = kBase1 + 0x0042u;   // 0x7e42
+constexpr uint32_t kRegRbArbCtrl           = kBase0 + 0x0706u;   // 0x7f06
+constexpr uint32_t kRegRb1DbCtrl           = kBase1 + 0x0072u;   // 0x7e72
+constexpr uint32_t kRegRbBaseLo            = kBase1 + 0x00eau;   // 0x7eea
+constexpr uint32_t kRegRbBaseHi            = kBase1 + 0x00ebu;   // 0x7eeb
+constexpr uint32_t kRegRbSize              = kBase1 + 0x00ecu;   // 0x7eec
+constexpr uint32_t kRegRbEnable            = kBase1 + 0x0085u;   // 0x7e85
+constexpr uint32_t kRegRbRptr              = kBase1 + 0x00acu;   // 0x7eac
+constexpr uint32_t kRegRbWptr              = kBase1 + 0x00adu;   // 0x7ead
+
+// ---------------------------------------------------------------------------------------------------------------
+// Field values (vcn_4_0_0_sh_mask.h and the engine_status_constants enum in amdgpu_vcn.h).
+// ---------------------------------------------------------------------------------------------------------------
+constexpr uint32_t kPgfsmStatusMask   = 0x3F3FFFFFu;
+// PGFSM plane encoding (vcn_v4_0.c): status 0 = plane ON, 2 = plane OFF. The SMU's PowerUpVcn leaves every plane
+// off (0x2AAAAAAA); disable_static_power_gating turns M/S/LMI on and must see 0x2A2A8AA0 before any other VCN
+// register is touched -- reading UVD_STATUS with the planes off hard-resets the machine (seen 2026-11-21).
+constexpr uint32_t kPgfsmPoweredNoPg  = 0x00000000u;   // non-PG path, instance 0: every plane on
+constexpr uint32_t kPgfsmPoweredPg    = 0x2A2A8AA0u;   // UVD_PGFSM_STATUS__UVDM_UVDU_UVDLM_PWR_ON_3_0
+constexpr uint32_t kPgfsmGated        = 0x2A2AAAAAu;   // every plane off (enable_static_power_gating wait)
+constexpr uint32_t kPgfsmConfigNoPg   = 0x15155555u;   // non-PG path: every plane = 1
+constexpr uint32_t kPgfsmConfigPg     = 0x2A2A9AA5u;   // PG path (Phoenix has AMD_PG_SUPPORT_VCN): M/S/LMI = 1, rest = 2
+constexpr uint32_t kPgfsmConfigGate   = 0x2A2AAAAAu;   // enable_static_power_gating: every plane = 2
+constexpr uint32_t kPowerStatusKeep   = ~0x103u;       // Linux: data &= ~0x103
+constexpr uint32_t kPowerStatusPgOn   = 0x2u | 0x100u; // UVDM_UVDU_PWR_ON | UVD_PG_EN
+constexpr uint32_t kPowerStatusMask   = 0x3u;          // UVD_POWER_STATUS__UVD_POWER_STATUS_MASK
+constexpr uint32_t kPowerStatusTilesOff = 0x1u;        // UVD_POWER_STATUS__UVD_POWER_STATUS_TILES_OFF
+// Read back after a VCPU boot timeout (vcn_4_0_0_offset.h, BASE_IDX 1 = 0x7e00 + offset).
+constexpr uint32_t kVcnDiagRegs[] = {
+    0x7f43u /* UVD_STATUS */, 0x7f96u /* VCPU_CNTL */, 0x7f47u /* SOFT_RESET */, 0x7f06u /* RB_ARB_CTRL */,
+    0x7ee1u /* MASTINT_EN */, 0x80aeu /* LMI_CTRL2 */, 0x80b0u /* LMI_CTRL */, 0x80b1u /* LMI_STATUS */,
+    0x7ec1u /* CGC_GATE */, 0x7ec2u /* CGC_CTRL */, 0x7ec4u /* SUVD_CGC_GATE */, 0x7e02u /* POWER_STATUS */,
+    0x7f81u /* VCPU_CACHE_SIZE0 */, 0x8044u /* CACHE_BAR_LO */, 0x8045u /* CACHE_BAR_HI */,
+    0x7ed0u /* GPCOM_VCPU_DATA0 */, 0x7e15u /* SCRATCH1 */, 0x7e01u /* PGFSM_STATUS */,
+};
+// Register sweep of VCN's two segments (0x7e00..0x80ff), written to VRAM after a VCPU boot timeout: addresses that
+// read all-ones are not backed by hardware (mis-mapped or in an unpowered sub-block). Read-only.
+constexpr uint32_t kSweepOff   = 0xC940000u;
+constexpr uint32_t kSweepFirst = 0x7e00u;
+constexpr uint32_t kSweepCount = 0x0300u;
+constexpr uint32_t kSweepMagic = 0x53574356u;   // "CVWS"
+// DPG-mode constants (vcn_v4_0_start_dpg_mode). The VCPU-side registers are written through UVD_DPG_LMA_* rather
+// than directly: direct writes to them do not take on this chip (they read back all-ones), the port does not.
+constexpr uint32_t kDpgVidSocBase = 0x1FB00u;   // VCN_VID_SOC_ADDRESS_2_0 (bytes, 20-bit window)
+constexpr uint32_t kDpgAonSocBase = 0x1F800u;   // VCN_AON_SOC_ADDRESS_2_0
+constexpr uint32_t kDpgAonIpBase  = 0x30000u;   // VCN_AON_IP_ADDRESS_2_0
+constexpr uint32_t kPowerStatusPgEn = 0x00000100u;   // UVD_POWER_STATUS__UVD_PG_EN_MASK
+// Phoenix NBIF 7.7.0, from IP discovery and the Linux VCN0 range programming.
+constexpr uint32_t kRsmuIndex = 0x14u;
+constexpr uint32_t kRsmuData = 0x15u;
+constexpr uint32_t kDoorbellApertureReg = 0xDE0u; // NBIO 7.7.0 base[2] + RCC aperture enable
+constexpr uint32_t kVcnDoorbellRangeAddr = (0x10400u + 0x4f0af3u) * 4u;
+constexpr uint32_t kDbRangeStart = 0x310u;
+constexpr uint32_t kVcnDoorbellFields = 0x001F0FFCu; // NBIO 7.7.0 SIZE_MASK | OFFSET_MASK
+constexpr uint32_t kDbRangeCount = 8u;
+constexpr uint32_t kVcnDoorbellRange = (kDbRangeCount << 16) | (kDbRangeStart << 2);
+constexpr uint32_t kDbIndexLinux = 0x312u;
+constexpr uint32_t kPowerStatusPgMode = 0x00000004u;   // UVD_POWER_STATUS__UVD_PG_MODE_MASK
+constexpr uint32_t kDpgLmiCtrl    = 0x00307308u;       // WRITE_CLEAN_TIMER_EN|REQ_MODE|CRC_RESET|MASK_MC_URGENT|
+                                                       // DATA_COHERENCY_EN|VCPU_DATA_COHERENCY_EN|8|0x100000
+constexpr uint32_t kDpgLmiCtrl2   = 0x003E0000u;       // 0x1f << RE_OFLD_MIF_WR_REQ_NUM_SHIFT
+constexpr uint32_t kDpgMpcCntl    = 0x00000010u;       // 0x2 << REPLACEMENT_MODE_SHIFT
+// vcn_v4_0_disable_clock_gating. The masks are the OR of the fields Linux clears or sets, taken from
+// vcn_4_0_0_sh_mask.h; kCgcCtrlTiming is 1 << CLK_GATE_DLY_TIMER | 4 << CLK_OFF_DELAY.
+constexpr uint32_t kCgcCtrlDynMode     = 0x00000001u;   // UVD_CGC_CTRL__DYN_CLOCK_MODE_MASK
+constexpr uint32_t kCgcCtrlTiming      = 0x00000104u;
+constexpr uint32_t kCgcGateClear       = 0x0017ffffu;   // SYS..MMSCH (20 gate fields)
+constexpr uint32_t kCgcCtrlClear       = 0xbffff800u;   // the same 20 fields' *_MODE bits (DYN_CLOCK_MODE kept out)
+constexpr uint32_t kSuvdCgcGateSet     = 0x01feffffu;   // 24 SUVD gate fields
+constexpr uint32_t kSuvdCgcCtrlClear   = 0x000003ffu;   // 10 SUVD *_MODE fields
+constexpr uint32_t kUvdStatusBusy     = 0x00000004u;   // UVD_STATUS__UVD_BUSY
+constexpr uint32_t kUvdStatusVcpuRdy  = 0x00000002u;   // bit 1: VCPU reported firmware ready
+constexpr uint32_t kVcpuCntlClkEn     = 0x00000200u;
+constexpr uint32_t kVcpuCntlBlkRst    = 0x10000000u;
+// UVD_VCPU_CNTL reads all-ones for every reserved bit, so it must be written outright (never read-modify-write).
+// vcn_v4_0_start_dpg_mode: (0xFF << PRB_TIMEOUT_VAL) | CLK_EN | BLK_RST, then the same value without BLK_RST.
+constexpr uint32_t kVcpuCntlHold      = 0x1FF00200u;   // (0xFF << 20) | CLK_EN | BLK_RST: VCPU held in reset
+constexpr uint32_t kVcpuCntlRun       = 0x0FF00200u;   // (0xFF << 20) | CLK_EN: BLK_RST released
+constexpr uint32_t kMastintEnVcpuEn   = 0x00000002u;
+constexpr uint32_t kLmiCtrl2StallUmc  = 0x00000100u;
+constexpr uint32_t kSoftResetLmi      = 0x00000004u;
+constexpr uint32_t kSoftResetLmiUmc   = 0x00002000u;
+constexpr uint32_t kLmiCtrlFlags      = 0x00000100u | 0x00001000u | 0x00002000u | 0x00200000u;
+constexpr uint32_t kMpcCntlReplMask   = 0x00000038u;
+constexpr uint32_t kMpcCntlReplShift  = 3u;
+constexpr uint32_t kMpcCntlReplMode   = 2u;
+constexpr uint32_t kRbArbCtrlVcpuDis  = 0x00000008u;
+constexpr uint32_t kRb1DbCtrlOffsetShift = 2u;
+constexpr uint32_t kRb1DbCtrlEn       = 0x40000000u;
+constexpr uint32_t kRbEnableRb1       = 0x00000004u;
+
+// UVD_MPC_SET_MUX{A,B}0 / SET_MUX constant data (vcn_v4_0_start): 1,2,3,4 in the four VAR fields.
+constexpr uint32_t kMpcSetMuxA =
+    (1u << 6) | (2u << 12) | (3u << 18) | (4u << 24);
+constexpr uint32_t kMpcSetMuxB =
+    (1u << 6) | (2u << 12) | (3u << 18) | (4u << 24);
+constexpr uint32_t kMpcSetMux = (0u << 0) | (1u << 3) | (2u << 6);
+
+// fw_shared (struct amdgpu_vcn4_fw_shared, sizeof 148, page-aligned by Linux). Offsets are byte offsets.
+constexpr uint32_t kSharedPresentFlags = 0u;     // present_flag_0 precedes 12 reserved bytes
+constexpr uint32_t kSharedSq           = 16u;   // is_enabled (+0), queue_mode (+1), queue_status (+2)
+constexpr uint32_t kSharedSqEnabled    = 1u;
+constexpr uint32_t kSharedSmuInterface = 120u;  // smu_interface_type = 1 (APU)
+constexpr uint32_t kSharedDrmKey       = 124u;  // method = 2 (VCNFW/ASD handshaking workaround)
+constexpr uint32_t kSharedSize         = 4096u; // AMDGPU_GPU_PAGE_ALIGN(sizeof(...))
+
+constexpr uint32_t kFwFlagUnifiedQueue = 1u << 2;
+constexpr uint32_t kFwFlagDrmKeyInject = 1u << 4;
+constexpr uint32_t kFwFlagSmuDpm       = 1u << 11;
+constexpr uint32_t kFwDrmKeyMethod     = 2u;
+constexpr uint32_t kFwSmuInterfaceApu  = 1u;
+constexpr uint32_t kFwQueueRingReset   = 1u;
+constexpr uint32_t kFwQueueDpgHoldOff  = 2u;
+
+// Unified ring (amdgpu_ring_init(..., 512 dw)): 512 dwords = 2048 B, 64-byte aligned, metadata 36 B after it.
+constexpr uint32_t kRingDw     = 512u;
+constexpr uint32_t kRingBytes  = kRingDw * 4u;
+constexpr uint32_t kRingAlign  = 64u;
+constexpr uint32_t kRbMetadataBytes = 36u;
+constexpr uint32_t kRingCommitAlignDw = 64u;     // vcn_v4_0_unified_ring_vm_funcs.align_mask + 1
+constexpr uint32_t kCmdNop     = 0x00000000u;   // VCN_ENC_CMD_NO_OP
+constexpr uint32_t kCmdEnd     = 0x00000001u;   // VCN_ENC_CMD_END
+constexpr uint32_t kCmdFence   = 0x00000003u;   // VCN_ENC_CMD_FENCE
+constexpr uint32_t kFenceDwords = 5u;           // FENCE, addr lo/hi, seq, END (polled, no interrupt)
+
+// VRAM layout of the per-instance block (byte offsets inside the 256 MiB BAR0 aperture):
+// stack 128 KiB, context 512 KiB, fw_shared 4 KiB, ring 2 KiB + metadata. 200 MiB leaves the 64 MiB TMR
+// (0x8000000..0xC000000) and everything below it untouched.
+constexpr uint32_t kBoOffset  = 0xC800000u;   // 200 MiB
+constexpr uint32_t kBoSize    = 0x100000u;    // 1 MiB
+constexpr uint32_t kStackOff  = 0x00000u;
+constexpr uint32_t kStackSize = 128u * 1024u;
+constexpr uint32_t kCtxOff    = kStackOff + kStackSize;   // 0x20000
+constexpr uint32_t kCtxSize   = 512u * 1024u;
+constexpr uint32_t kSharedOff = kCtxOff + kCtxSize;       // 0xA0000
+constexpr uint32_t kRingOff   = kSharedOff + kSharedSize; // 0xA1000
+constexpr uint32_t kMetaOff   = kRingOff + kRingBytes;    // 0xA1800
+constexpr uint32_t kSramOff   = 0xB1000u;                 // 512 B DPG command list (64 offset/value pairs)
+constexpr uint32_t kPspFwTypeVcnRam = 49u;             // GFX_FW_TYPE_VCN0_RAM
+constexpr uint32_t kWbOff     = 0xB0000u;                 // 32-bit fence value the firmware writes
+constexpr uint32_t kWbSize    = 4u;
+
+// Private, synchronous session diagnostics in unused pages of the existing per-instance BO.
+constexpr uint32_t kCodecIbOff = 0xB3000u;
+constexpr uint32_t kCodecDataOff = 0xB4000u;
+constexpr uint32_t kEncodeContextBytes = 128u * 1024u;
+static_assert(kSramOff + 8192u <= kCodecIbOff && kCodecIbOff + 4096u <= kCodecDataOff &&
+              kCodecDataOff + kEncodeContextBytes <= kBoSize, "VCN diagnostic buffers overlap");
+
+// PSP LOAD_IP_FW firmware type for VCN (psp_gfx_if.h: GFX_FW_TYPE_VCN = 13).
+constexpr uint32_t kPspFwTypeVcn = 13u;
+// SMU 13.0.4 messages (smu_v13_0_4_ppsmc.h).
+constexpr uint32_t kPpsmcPowerDownVcn = 0x06u;
+constexpr uint32_t kPpsmcPowerUpVcn   = 0x07u;
+constexpr uint32_t kPpsmcResultOk     = 0x01u;
+
+// common_firmware_header (amdgpu_ucode.h), the 32 bytes at the start of vcn_4_0_0.bin.
+struct FwHeader {
+    uint32_t sizeBytes;
+    uint32_t headerSizeBytes;
+    uint16_t headerVersionMajor;
+    uint16_t headerVersionMinor;
+    uint16_t ipVersionMajor;
+    uint16_t ipVersionMinor;
+    uint32_t ucodeVersion;
+    uint32_t ucodeSizeBytes;
+    uint32_t ucodeArrayOffsetBytes;
+    uint32_t crc32;
+};
+static_assert(sizeof(FwHeader) == 32, "common_firmware_header is 32 bytes");
+
+// Rejects anything that is not the VCN 4.0 image this block runs: header v1.0, IP 4.0, a 4-byte aligned
+// ucode array that lies inside the buffer, and a non-empty ucode that ends inside it. Pure function so the
+// host test can feed it the real vcn_4_0_0.bin header plus a set of broken ones.
+inline bool fwHeaderOk(const FwHeader &h, uint32_t fileLen, uint32_t *ucodeOff, uint32_t *ucodeSize) {
+    if (h.headerSizeBytes != 32u || h.headerVersionMajor != 1u || h.headerVersionMinor != 0u)
+        return false;
+    if (h.ipVersionMajor != 4u || h.ipVersionMinor != 0u)
+        return false;
+    if (h.ucodeArrayOffsetBytes < h.headerSizeBytes || (h.ucodeArrayOffsetBytes & 3u))
+        return false;
+    if (h.ucodeSizeBytes == 0u || h.ucodeSizeBytes > (16u << 20))
+        return false;
+    // 64-bit arithmetic: a corrupt header must not wrap the bounds check.
+    const uint64_t end = static_cast<uint64_t>(h.ucodeArrayOffsetBytes) + h.ucodeSizeBytes;
+    if (h.sizeBytes != fileLen || end > fileLen)
+        return false;
+    *ucodeOff = h.ucodeArrayOffsetBytes;
+    *ucodeSize = h.ucodeSizeBytes;
+    return true;
+}
+
+// SOC15_DPG_MODE_OFFSET from amdgpu_vcn.h: the internal (VCPU-side) address of an MMIO register.
+inline uint32_t dpgModeOffset(uint32_t reg) {
+    const uint32_t low = (reg << 2) & 0xFFFFFu;
+    uint32_t internal;
+    if (low >= kDpgVidSocBase && low < kDpgVidSocBase + 0x2600u)
+        internal = low - kDpgVidSocBase;
+    else if (low >= kDpgAonSocBase && low < kDpgAonSocBase + 0x600u)
+        internal = low - kDpgAonSocBase + kDpgAonIpBase;
+    else
+        internal = low;
+    return internal >> 2;
+}
+
+inline uint32_t firmwareCacheBytes(uint32_t ucodeSize) {
+    return (ucodeSize + 8u + 0xFFFu) & ~0xFFFu;
+}
+
+// Phoenix uses VCN MGCG and has no VCN RAS writes in the 216-byte command list.
+// vcn_v4_0_mc_resume_dpg_mode uses placeholders for the firmware window and stack
+// address in a VCN0_RAM list. The direct port needs their actual values.
+template<typename Write>
+inline void writeDpgSetup(Write write, bool indirect, uint64_t firmware, uint32_t cacheBytes,
+                          uint64_t stack, uint64_t context, uint64_t shared, uint32_t addrConfig) {
+    write(kRegVcpuCntl, kVcpuCntlHold);
+    write(kRegMastintEn, 0);
+    write(kRegLmiCtrl, kDpgLmiCtrl);
+    write(kRegMpcCntl, kDpgMpcCntl);
+    write(kRegMpcSetMuxA0, kMpcSetMuxA);
+    write(kRegMpcSetMuxB0, kMpcSetMuxB);
+    write(kRegMpcSetMux, kMpcSetMux);
+    write(kRegLmiVcpuCacheBarLo, indirect ? 0u : static_cast<uint32_t>(firmware));
+    write(kRegLmiVcpuCacheBarHi, indirect ? 0u : static_cast<uint32_t>(firmware >> 32));
+    write(kRegVcpuCacheOffset0, 0);
+    write(kRegVcpuCacheSize0, indirect ? 0u : cacheBytes);
+    write(kRegLmiVcpuCache1BarLo, indirect ? 0u : static_cast<uint32_t>(stack));
+    write(kRegLmiVcpuCache1BarHi, indirect ? 0u : static_cast<uint32_t>(stack >> 32));
+    write(kRegVcpuCacheOffset1, 0);
+    write(kRegVcpuCacheSize1, kStackSize);
+    write(kRegLmiVcpuCache2BarLo, static_cast<uint32_t>(context));
+    write(kRegLmiVcpuCache2BarHi, static_cast<uint32_t>(context >> 32));
+    write(kRegVcpuCacheOffset2, 0);
+    write(kRegVcpuCacheSize2, kCtxSize);
+    write(kRegLmiVcpuNc0BarLo, static_cast<uint32_t>(shared));
+    write(kRegLmiVcpuNc0BarHi, static_cast<uint32_t>(shared >> 32));
+    write(kRegVcpuNoncacheOffset0, 0);
+    write(kRegVcpuNoncacheSize0, kSharedSize);
+    write(kRegGfx10AddrConfig, addrConfig);
+}
+
+template<typename Write>
+inline void writeDpgRelease(Write write) {
+    write(kRegVcpuCntl, kVcpuCntlRun);
+    write(kRegLmiCtrl2, kDpgLmiCtrl2);
+    write(kRegMastintEn, kMastintEnVcpuEn);
+}
+
+inline bool firmwareFitsTmr(uint64_t fwMc, uint32_t cacheBytes, uint64_t tmrMc, uint64_t tmrBytes) {
+    return fwMc != 0 && fwMc >= tmrMc && cacheBytes != 0 &&
+           cacheBytes <= tmrBytes && fwMc - tmrMc <= tmrBytes - cacheBytes;
+}
+
+inline uint32_t ringSlot(uint32_t ptr) { return ptr & (kRingDw - 1u); }
+
+inline uint32_t ringCommitAfter(uint32_t wptr, uint32_t packetDw) {
+    return (wptr + packetDw + kRingCommitAlignDw - 1u) & ~(kRingCommitAlignDw - 1u);
+}
+
+// The diagnostic ring uses a polled 32-bit fence, so it omits Linux's trailing interrupt TRAP.
+inline void buildFencePacket(uint32_t dw[kFenceDwords], uint64_t mc, uint32_t seq) {
+    dw[0] = kCmdFence;
+    dw[1] = static_cast<uint32_t>(mc);
+    dw[2] = static_cast<uint32_t>(mc >> 32);
+    dw[3] = seq;
+    dw[4] = kCmdEnd;
+}
+
+// VCN_ENC_CMD_IB for a driver-owned VRAM allocation, followed by a polled completion fence.
+inline void buildIbFencePacket(uint32_t *dw, uint64_t ibMc, uint32_t ibDw, uint64_t fenceMc, uint32_t seq) {
+    dw[0] = 2u;
+    dw[1] = 0u; // VMID 0
+    dw[2] = static_cast<uint32_t>(ibMc);
+    dw[3] = static_cast<uint32_t>(ibMc >> 32);
+    dw[4] = ibDw;
+    buildFencePacket(dw + 5, fenceMc, seq);
+}
+
+} // namespace phx_vcn
+
+#endif // PHX_VCN_H
diff -ruN -x build -x *.o a/src/phxbringup/PhxVcnAperture.h b/src/phxbringup/PhxVcnAperture.h
--- a/src/phxbringup/PhxVcnAperture.h	1970-01-01 08:00:00
+++ b/src/phxbringup/PhxVcnAperture.h	2026-11-24 00:56:00
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace phx_vcn {
+
+// Use aligned, explicit 64-bit device accesses through BAR0.
+inline void readApertureRow(uint8_t *dst, const volatile uint8_t *src, uint32_t size) {
+    while (size >= sizeof(uint64_t)) {
+        const uint64_t word = *reinterpret_cast<const volatile uint64_t *>(src);
+        __builtin_memcpy(dst, &word, sizeof(word));
+        src += sizeof(word);
+        dst += sizeof(word);
+        size -= sizeof(word);
+    }
+    while (size--) *dst++ = *src++;
+}
+
+inline void writeAperture(volatile uint8_t *dst, const uint8_t *src, uint32_t size) {
+    while (size >= sizeof(uint64_t)) {
+        uint64_t word;
+        __builtin_memcpy(&word, src, sizeof(word));
+        *reinterpret_cast<volatile uint64_t *>(dst) = word;
+        src += sizeof(word);
+        dst += sizeof(word);
+        size -= sizeof(word);
+    }
+    while (size--) *dst++ = *src++;
+}
+
+inline void clearAperture(volatile uint8_t *dst, uint32_t size) {
+    while (size && (reinterpret_cast<uintptr_t>(dst) & 7u)) {
+        *dst++ = 0;
+        --size;
+    }
+    while (size >= sizeof(uint64_t)) {
+        *reinterpret_cast<volatile uint64_t *>(dst) = 0;
+        dst += sizeof(uint64_t);
+        size -= sizeof(uint64_t);
+    }
+    while (size--) *dst++ = 0;
+}
+
+} // namespace phx_vcn
diff -ruN -x build -x *.o a/src/phxbringup/PhxVcnAvcStream.h b/src/phxbringup/PhxVcnAvcStream.h
--- a/src/phxbringup/PhxVcnAvcStream.h	1970-01-01 08:00:00
+++ b/src/phxbringup/PhxVcnAvcStream.h	2026-11-24 00:56:00
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: MIT
+#ifndef PHX_VCN_AVC_STREAM_H
+#define PHX_VCN_AVC_STREAM_H
+
+#include "PhxVcnDecode.h"
+
+namespace phx_vcn {
+
+constexpr uint32_t kAvcStreamMaxBitstreamBytes = 1024u * 1024u;
+constexpr uint32_t kAvcStreamAlignment = 4096u;
+constexpr uint32_t kAvcStreamScratchOffset = 234u * 1024u * 1024u;
+constexpr uint32_t kAvcStreamScratchLimit = 22u * 1024u * 1024u;
+constexpr uint32_t kAvcStreamSlotCount = 6;
+constexpr uint32_t kAvcStreamSlotBytes = 8u << 20;
+// Codec context per slot, CPU-visible inside the BAR0 aperture. Slots sit in
+// the 80..128 MiB window; the DPB banks start above the 256 MiB aperture
+// because only the GPU addresses them.
+constexpr uint32_t kAvcContextBankOffset = 80u << 20;
+constexpr uint32_t kAvcContextBankBytes = kAvcStreamSlotBytes;
+// Reference pictures per firmware handle. GPU-only, outside the aperture. PhxAMDFB
+// places its second scan-out surface at 512 MiB (phxfb.cpp gDbufOffMb), so start at 1 GiB.
+constexpr uint32_t kAvcDpbBankOffset = 1024u << 20;
+constexpr uint32_t kAvcDpbBankBytes = 32u << 20;
+constexpr uint32_t avcContextSlotOffset(uint32_t slot) {
+    return kAvcContextBankOffset + slot * kAvcContextBankBytes;
+}
+constexpr uint32_t avcDpbBankOffset(uint32_t slot) {
+    return kAvcDpbBankOffset + slot * kAvcDpbBankBytes;
+}
+static_assert(kAvcStreamSlotBytes % kAvcStreamAlignment == 0, "AVC slot alignment");
+static_assert(kAvcContextBankBytes >= 1u << 20 && avcContextSlotOffset(kAvcStreamSlotCount) <= 128u << 20,
+              "AVC context banks must stay inside the aperture");
+constexpr uint32_t kAvcStreamMessageDw = 342u;
+constexpr uint32_t kAvcStreamFeedbackDw = 11u;
+constexpr uint32_t kAvcStreamScalingBytes = 224u;
+
+// Parsed H.264 syntax. The kernel owns the handle, reference state, sizes and all GPU addresses.
+struct AvcStreamSequence {
+    uint32_t codedWidth, codedHeight, visibleWidth, visibleHeight;
+    uint8_t profileIdc, levelIdc, log2MaxFrameNumMinus4, picOrderCntType;
+    uint8_t log2MaxPicOrderCntLsbMinus4, maxNumRefFrames;
+    bool direct8x8Inference;
+};
+
+constexpr uint32_t kAvcMaxReferences = 16; // H.264 limit; the VCN message carries 16 entries.
+
+struct AvcReference {
+    uint32_t frameNum;
+    int32_t topPoc, bottomPoc;
+    uint8_t slot;
+};
+
+struct AvcStreamPicture {
+    uint32_t frameNum;
+    int32_t topPoc, bottomPoc;
+    AvcReference references[kAvcMaxReferences];
+    uint8_t referenceCount, currentSlot;
+    uint8_t l0DefaultMinus1, l1DefaultMinus1, weightedBipredIdc;
+    int8_t picInitQpMinus26, chromaQpIndexOffset, secondChromaQpIndexOffset;
+    bool idr, entropyCoding, bottomFieldPocPresent, deblockingControlPresent;
+    bool constrainedIntraPred, weightedPred, transform8x8;
+};
+
+struct AvcStreamGeometry {
+    uint32_t pitch, lumaBytes, targetBytes;
+    uint32_t dpbPitch, dpbChromaPitch, dpbHeight, dpbBytes, contextBytes;
+    uint32_t messageOffset, feedbackOffset, scalingOffset, bitstreamOffset;
+    uint32_t targetOffset, stagingBytes;
+    uint32_t dpbOffset, contextOffset, persistentBytes;
+    bool separateDpb;
+};
+
+constexpr uint32_t avcStreamAlign(uint32_t value, uint32_t alignment) {
+    return (value + alignment - 1u) & ~(alignment - 1u);
+}
+
+inline bool avcStreamGeometry(const AvcStreamSequence &sequence, AvcStreamGeometry &geometry) {
+    geometry = {};
+    if (sequence.codedWidth < 64 || sequence.codedWidth > 1920 || sequence.codedWidth % 16 ||
+        sequence.codedHeight < 64 || sequence.codedHeight > 1088 || sequence.codedHeight % 16 ||
+        sequence.visibleWidth < 64 || sequence.visibleWidth > sequence.codedWidth || sequence.visibleWidth % 2 ||
+        sequence.visibleHeight < 64 || sequence.visibleHeight > sequence.codedHeight || sequence.visibleHeight % 2 ||
+        (sequence.profileIdc != 66 && sequence.profileIdc != 77 && sequence.profileIdc != 100) ||
+        sequence.log2MaxFrameNumMinus4 > 12 || sequence.maxNumRefFrames > kAvcMaxReferences ||
+        (sequence.picOrderCntType != 0 && sequence.picOrderCntType != 2) ||
+        sequence.log2MaxPicOrderCntLsbMinus4 > 12 ||
+        (sequence.picOrderCntType == 2 && sequence.log2MaxPicOrderCntLsbMinus4)) return false;
+
+    // H.264 Annex A maximum frame sizes in macroblocks.
+    struct Level { uint8_t idc; uint32_t maxFrameMbs, maxDpbMbs; };
+    constexpr Level levels[] = {{10, 99, 396}, {11, 396, 900}, {12, 396, 2376}, {13, 396, 2376},
+        {20, 396, 2376}, {21, 792, 4752}, {22, 1620, 8100}, {30, 1620, 8100}, {31, 3600, 18000},
+        {32, 5120, 20480}, {40, 8192, 32768}, {41, 8192, 32768}, {42, 8704, 34816}};
+    const uint32_t widthMbs = sequence.codedWidth / 16u;
+    const uint32_t heightMbs = sequence.codedHeight / 16u;
+    uint32_t maxFrameMbs = 0, maxDpbMbs = 0;
+    for (const Level &level : levels) {
+        if (level.idc == sequence.levelIdc) {
+            maxFrameMbs = level.maxFrameMbs;
+            maxDpbMbs = level.maxDpbMbs;
+            break;
+        }
+    }
+    if (widthMbs * heightMbs > maxFrameMbs || widthMbs * widthMbs > 8u * maxFrameMbs ||
+        heightMbs * heightMbs > 8u * maxFrameMbs ||
+        widthMbs * heightMbs * sequence.maxNumRefFrames > maxDpbMbs) return false;
+
+    // Tier 0 must keep the pre-decode DPB intact until the current picture is complete.
+    const uint32_t slots = sequence.maxNumRefFrames + 1u;
+
+    AvcStreamGeometry candidate{};
+    candidate.pitch = avcStreamAlign(sequence.codedWidth, 256u);
+    candidate.lumaBytes = candidate.pitch * sequence.codedHeight;
+    candidate.targetBytes = candidate.lumaBytes * 3u / 2u;
+    candidate.dpbPitch = avcStreamAlign(sequence.codedWidth, 32u);
+    candidate.dpbChromaPitch = avcStreamAlign(sequence.codedWidth / 2u, 32u);
+    candidate.dpbHeight = avcStreamAlign(sequence.codedHeight, 64u);
+    const uint32_t dpbLumaBytes = candidate.dpbPitch * candidate.dpbHeight;
+    // UV pitch counts two-byte pairs. The chroma plane has half the luma rows.
+    const uint32_t dpbChromaBytes = candidate.dpbChromaPitch * 2u * (candidate.dpbHeight / 2u);
+    candidate.dpbBytes = slots * avcStreamAlign(dpbLumaBytes + dpbChromaBytes, 1024u);
+    const uint32_t contextMbs = widthMbs * avcStreamAlign(heightMbs, 2u);
+    candidate.contextBytes = slots * avcStreamAlign(contextMbs * 192u, 256u);
+    // vcnLock covers the complete submit, fence, and readback. These buffers
+    // can reuse the legacy frame scratch on every invocation.
+    candidate.messageOffset = 0;
+    candidate.feedbackOffset = candidate.messageOffset + kAvcStreamAlignment;
+    candidate.scalingOffset = candidate.feedbackOffset + kAvcStreamAlignment;
+    candidate.bitstreamOffset = candidate.scalingOffset + kAvcStreamAlignment;
+    candidate.targetOffset = candidate.bitstreamOffset + kAvcStreamMaxBitstreamBytes;
+    candidate.stagingBytes = avcStreamAlign(candidate.targetOffset + candidate.targetBytes, kAvcStreamAlignment);
+    // The firmware session, its reference pictures and its codec context must
+    // survive intervening frames from other streams.
+    candidate.dpbOffset = kDecodeSessionBytes;
+    candidate.contextOffset = avcStreamAlign(candidate.dpbOffset + candidate.dpbBytes, kAvcStreamAlignment);
+    candidate.persistentBytes = avcStreamAlign(candidate.contextOffset + candidate.contextBytes, kAvcStreamAlignment);
+    if (candidate.persistentBytes > kAvcStreamSlotBytes) {
+        if (candidate.dpbBytes > kAvcDpbBankBytes) return false;
+        candidate.separateDpb = true;
+        candidate.dpbOffset = 0;
+        candidate.contextOffset = kDecodeSessionBytes;
+        candidate.persistentBytes = avcStreamAlign(candidate.contextOffset + candidate.contextBytes, kAvcStreamAlignment);
+    }
+    if (candidate.persistentBytes > kAvcStreamSlotBytes ||
+        candidate.stagingBytes > kAvcStreamScratchOffset - kDecodeFrameScratchOffset) return false;
+    geometry = candidate;
+    return true;
+}
+
+// The firmware session's identity. An IDR may reuse the session in place when
+// everything the create message fixed is unchanged: the geometry the buffers
+// were sized for, the profile, and the reference picture count. The parser
+// already empties the reference list on an IDR, so the per-frame message fully
+// describes the fresh state (Mesa never recreates its session on an IDR either).
+struct AvcSessionKey {
+    uint32_t codedWidth, codedHeight;
+    uint32_t persistentBytes, stagingBytes, bankBytes;
+    uint8_t profileIdc, maxRefs;
+};
+
+inline bool avcSessionMatches(const AvcSessionKey &stored, const AvcSessionKey &wanted, bool errorFree,
+                              bool reuseEnabled) {
+    return reuseEnabled && errorFree && stored.codedWidth == wanted.codedWidth &&
+        stored.codedHeight == wanted.codedHeight && stored.persistentBytes == wanted.persistentBytes &&
+        stored.stagingBytes == wanted.stagingBytes && stored.bankBytes == wanted.bankBytes &&
+        stored.profileIdc == wanted.profileIdc && stored.maxRefs == wanted.maxRefs;
+}
+
+inline DecodeFrameBuffers avcStreamBuffers(uint64_t stagingMc, uint64_t persistentMc,
+                                         const AvcStreamGeometry &geometry, uint64_t dpbBankMc) {
+    return {stagingMc + geometry.messageOffset, geometry.separateDpb ? dpbBankMc : persistentMc + geometry.dpbOffset,
+            stagingMc + geometry.targetOffset, persistentMc,
+            stagingMc + geometry.bitstreamOffset, persistentMc + geometry.contextOffset,
+            stagingMc + geometry.feedbackOffset, stagingMc + geometry.scalingOffset};
+}
+
+inline bool buildAvcStreamMessage(uint32_t (&words)[kAvcStreamMessageDw],
+                                  uint8_t (&scaling)[kAvcStreamScalingBytes],
+                                  const AvcStreamSequence &sequence, const AvcStreamPicture &picture,
+                                  uint32_t handle, uint32_t feedbackNumber, uint32_t bitstreamBytes) {
+    AvcStreamGeometry geometry;
+    if (!avcStreamGeometry(sequence, geometry) || !handle || !feedbackNumber ||
+        bitstreamBytes < 5u || bitstreamBytes > kAvcStreamMaxBitstreamBytes) return false;
+    const uint32_t frameMask = (1u << (sequence.log2MaxFrameNumMinus4 + 4u)) - 1u;
+    if (picture.frameNum > frameMask || picture.referenceCount > sequence.maxNumRefFrames ||
+        picture.currentSlot > sequence.maxNumRefFrames ||
+        (picture.idr && (picture.frameNum || picture.referenceCount || picture.currentSlot)) ||
+        (!picture.idr && !picture.referenceCount) ||
+        picture.l0DefaultMinus1 >= 16 || picture.l1DefaultMinus1 >= 16 || picture.weightedBipredIdc > 2 ||
+        picture.picInitQpMinus26 < -26 || picture.picInitQpMinus26 > 25 ||
+        picture.chromaQpIndexOffset < -12 || picture.chromaQpIndexOffset > 12 ||
+        picture.secondChromaQpIndexOffset < -12 || picture.secondChromaQpIndexOffset > 12 ||
+        (sequence.profileIdc == 66 && (picture.entropyCoding || picture.weightedPred || picture.weightedBipredIdc)) ||
+        (sequence.profileIdc != 100 && picture.transform8x8)) return false;
+    uint32_t liveSlots = 1u << picture.currentSlot;
+    for (uint32_t i = 0; i < picture.referenceCount; ++i) {
+        const auto &ref = picture.references[i];
+        if (ref.frameNum > frameMask || ref.slot > sequence.maxNumRefFrames || (liveSlots & (1u << ref.slot)))
+            return false;
+        liveSlots |= 1u << ref.slot;
+    }
+
+    // VCN 4 firmware packet from Mesa ac_vcn_dec.h. Compile-time bounds keep
+    // the common header, indices and payloads within one cleared message page.
+    constexpr uint32_t headerBytes = 40u, indicesBytes = headerBytes + 16u;
+    constexpr uint32_t decodeBytes = 188u, codecOffset = indicesBytes + decodeBytes;
+    constexpr uint32_t codecBytes = 1124u;
+    static_assert(codecOffset + codecBytes == sizeof(words), "VCN AVC message layout");
+    static_assert(sizeof(words) <= kAvcStreamAlignment, "VCN AVC message page");
+    for (auto &word : words) word = 0;
+    words[0] = headerBytes;
+    words[1] = sizeof(words);
+    words[2] = 2; // Generic decode and AVC submessages.
+    words[3] = 1; // Render decode message.
+    words[4] = handle;
+    words[5] = feedbackNumber;
+    words[6] = 2;
+    words[7] = indicesBytes;
+    words[8] = decodeBytes;
+    words[10] = 6;
+    words[11] = codecOffset;
+    words[12] = codecBytes;
+
+    uint32_t *decode = words + indicesBytes / sizeof(uint32_t);
+    decode[0] = 7; // H.264 performance stream.
+    decode[2] = sequence.codedWidth;
+    decode[3] = sequence.codedHeight;
+    decode[4] = avcStreamAlign(bitstreamBytes, 128u);
+    decode[5] = geometry.dpbBytes;
+    decode[6] = geometry.targetBytes;
+    decode[9] = geometry.contextBytes;
+    decode[10] = kDecodeSessionBytes;
+    decode[18] = geometry.dpbPitch;
+    decode[19] = geometry.dpbHeight;
+    decode[22] = 3; // VCN 4.0.2 uses the GFX11 address library.
+    decode[25] = geometry.pitch;
+    decode[26] = geometry.pitch / 2u; // NV12 chroma samples each occupy two bytes.
+    decode[29] = 3;
+    decode[36] = geometry.lumaBytes;
+    decode[37] = geometry.lumaBytes;
+    decode[40] = 1; // MIF write control for VCN 3 and later.
+    decode[41] = geometry.dpbChromaPitch;
+
+    uint32_t *codec = words + codecOffset / sizeof(uint32_t);
+    codec[0] = sequence.profileIdc == 100 ? 2u : sequence.profileIdc == 77 ? 1u : 0u;
+    codec[1] = sequence.levelIdc;
+    codec[2] = 0x84u | static_cast<uint32_t>(sequence.direct8x8Inference);
+    codec[3] = static_cast<uint32_t>(picture.transform8x8) |
+        (static_cast<uint32_t>(picture.constrainedIntraPred) << 2) |
+        (static_cast<uint32_t>(picture.deblockingControlPresent) << 3) |
+        (static_cast<uint32_t>(picture.weightedBipredIdc) << 4) |
+        (static_cast<uint32_t>(picture.weightedPred) << 6) |
+        (static_cast<uint32_t>(picture.bottomFieldPocPresent) << 7) |
+        (static_cast<uint32_t>(picture.entropyCoding) << 8);
+    codec[4] = 1u | (static_cast<uint32_t>(sequence.log2MaxFrameNumMinus4) << 24);
+    codec[5] = sequence.picOrderCntType | (static_cast<uint32_t>(sequence.log2MaxPicOrderCntLsbMinus4) << 8) |
+        (static_cast<uint32_t>(sequence.maxNumRefFrames) << 16);
+    codec[6] = static_cast<uint8_t>(picture.picInitQpMinus26) |
+        (static_cast<uint32_t>(static_cast<uint8_t>(picture.chromaQpIndexOffset)) << 16) |
+        (static_cast<uint32_t>(static_cast<uint8_t>(picture.secondChromaQpIndexOffset)) << 24);
+    codec[7] = (static_cast<uint32_t>(picture.l0DefaultMinus1) << 16) |
+        (static_cast<uint32_t>(picture.l1DefaultMinus1) << 24);
+    for (auto &value : scaling) value = 16u; // Limit the candidate to flat scaling matrices.
+    for (uint32_t i = 0; i < sizeof(scaling) / sizeof(uint32_t); ++i) codec[9 + i] = 0x10101010u;
+
+    codec[65] = picture.frameNum;
+    codec[82] = static_cast<uint32_t>(picture.topPoc);
+    codec[83] = static_cast<uint32_t>(picture.bottomPoc);
+    // Mesa si_dec_h264 uses independent slots for decoded_pic_idx and ref_frame_list[].
+    // frame_num_list[] and field_order_cnt_list[] are packed in the same reference order.
+    codec[116] = picture.currentSlot;
+    codec[117] = picture.referenceCount;
+    for (uint32_t i = 118u; i < 122u; ++i) codec[i] = UINT32_MAX; // 16 absent slot IDs.
+    auto *slots = reinterpret_cast<uint8_t *>(codec + 118);
+    for (uint32_t i = 0; i < picture.referenceCount; ++i) {
+        const auto &ref = picture.references[i];
+        codec[66 + i] = ref.frameNum;
+        codec[84 + i * 2] = static_cast<uint32_t>(ref.topPoc);
+        codec[85 + i * 2] = static_cast<uint32_t>(ref.bottomPoc);
+        slots[i] = ref.slot;
+        codec[280] |= 3u << (2u * i); // Both fields of a progressive reference.
+    }
+    return true;
+}
+
+inline void initAvcStreamFeedback(uint32_t (&words)[kAvcStreamFeedbackDw]) {
+    for (auto &word : words) word = 0;
+    words[0] = sizeof(words);
+    words[1] = sizeof(words);
+}
+
+inline bool avcStreamFeedbackOK(const uint32_t (&words)[kAvcStreamFeedbackDw], uint32_t feedbackNumber) {
+    // Require an explicit report for this frame. The ring fence alone only
+    // acknowledges retirement of the submitted IB.
+    return feedbackNumber && words[0] == sizeof(words) && words[1] >= sizeof(words) &&
+        words[1] <= kAvcStreamAlignment && words[3] == feedbackNumber && !words[4] && !words[6];
+}
+
+} // namespace phx_vcn
+
+#endif
diff -ruN -x build -x *.o a/src/phxbringup/PhxVcnDecode.h b/src/phxbringup/PhxVcnDecode.h
--- a/src/phxbringup/PhxVcnDecode.h	1970-01-01 08:00:00
+++ b/src/phxbringup/PhxVcnDecode.h	2026-11-24 00:56:00
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: MIT
+// Fixed VCN 4 unified-queue decoder messages, matching amdgpu_vcn_dec_sw_ring_test_ib
+// in drivers/gpu/drm/amd/amdgpu/amdgpu_vcn.c. The create and destroy use the same handle.
+#ifndef PHX_VCN_DECODE_H
+#define PHX_VCN_DECODE_H
+
+#include <stdint.h>
+
+namespace phx_vcn {
+
+constexpr uint32_t kDecodeCreateDw = 14;
+constexpr uint32_t kDecodeDestroyDw = 6;
+constexpr uint32_t kDecodeIbDw = 43; // checksum (4), engine (4), buffer package (2 + 33)
+
+constexpr uint32_t kDecodeSessionBytes = 128u * 1024u;
+constexpr uint32_t kDecodeDpbBytes = 15923584u;
+constexpr uint32_t kDecodeTargetBytes = 737280u;
+constexpr uint32_t kDecodeOutputByteSum = 0x020345d8u;
+constexpr uint32_t kDecodeFrameWidth = 864u;
+constexpr uint32_t kDecodeFrameHeight = 480u;
+constexpr uint32_t kDecodeFrameHandle = 0x40440003u;
+constexpr uint32_t kDecodeReferenceFrameMessageDw = 59u;
+constexpr uint32_t kDecodeReferenceFrameCreateDw = 14u;
+constexpr uint32_t kDecodeReferenceFrameDestroyDw = 6u;
+
+// Private BAR0 range above MES/GART, the boot-time PSP TMR and VCN diagnostics.
+constexpr uint32_t kDecodeFrameScratchOffset = 0x0d000000u;
+constexpr uint32_t kDecodeFrameSessionContextOffset = 0;
+constexpr uint32_t kDecodeFrameMessageOffset = kDecodeSessionBytes;
+constexpr uint32_t kDecodeFrameFeedbackOffset = kDecodeFrameMessageOffset + 4096u;
+constexpr uint32_t kDecodeFrameScalingTableOffset = kDecodeFrameFeedbackOffset + 4096u;
+constexpr uint32_t kDecodeFrameBitstreamOffset = kDecodeFrameScalingTableOffset + 4096u;
+constexpr uint32_t kDecodeFrameDpbOffset =
+    (kDecodeFrameBitstreamOffset + 1408u + 4095u) & ~4095u;
+constexpr uint32_t kDecodeFrameContextOffset =
+    (kDecodeFrameDpbOffset + 0x006B9400u + 4095u) & ~4095u;
+constexpr uint32_t kDecodeFrameTargetOffset =
+    (kDecodeFrameDpbOffset + kDecodeDpbBytes + 4095u) & ~4095u;
+constexpr uint32_t kDecodeFrameRequiredBytes = kDecodeFrameTargetOffset + kDecodeTargetBytes;
+static_assert(kDecodeFrameContextOffset < kDecodeFrameTargetOffset, "decoder context must lie inside DPB");
+static_assert(kDecodeFrameScratchOffset + kDecodeFrameRequiredBytes <= 0x10000000u,
+              "decoder scratch exceeds Phoenix BAR0");
+
+// Caller clears and owns a page-aligned message page. Return the initialized part of the page.
+inline uint32_t buildDecodeSessionMsg(uint32_t *words, bool close, uint32_t width = 1920u,
+                                      uint32_t height = 1088u, uint32_t handle = 1u) {
+    words[0] = 40; // firmware message header size for both operations
+    words[1] = (close ? kDecodeDestroyDw : kDecodeCreateDw) * sizeof(uint32_t);
+    words[2] = close ? 0 : 1; // number of indexed submessages
+    words[3] = close ? 2 : 0; // destroy / create
+    words[4] = handle;
+    words[5] = 0; // feedback number
+    if (close)
+        return kDecodeDestroyDw;
+
+    words[6] = 1; // RDECODE_MESSAGE_CREATE
+    words[7] = 40; // submessage offset in bytes
+    words[8] = 16; // submessage size in bytes
+    words[9] = 0;
+    words[10] = 7; // H.264 performance stream
+    words[11] = 0; // session flags
+    words[12] = width;
+    words[13] = height;
+    return kDecodeCreateDw;
+}
+
+inline uint32_t buildDecodeFrameSessionMsg(uint32_t *words, bool close) {
+    if (close) {
+        const uint32_t message[] = {40, 24, 0, 2, kDecodeFrameHandle, 0};
+        for (uint32_t i = 0; i < kDecodeReferenceFrameDestroyDw; ++i)
+            words[i] = message[i];
+        return kDecodeReferenceFrameDestroyDw;
+    }
+    const uint32_t message[] = {
+        40, 56, 1, 0, kDecodeFrameHandle, 0, 1, 40, 16, 0, 7, 0,
+        kDecodeFrameWidth, kDecodeFrameHeight
+    };
+    for (uint32_t i = 0; i < kDecodeReferenceFrameCreateDw; ++i)
+        words[i] = message[i];
+    return kDecodeReferenceFrameCreateDw;
+}
+
+struct DecodeFrameBuffers {
+    uint64_t message;
+    uint64_t dpb;
+    uint64_t target;
+    uint64_t sessionContext;
+    uint64_t bitstream;
+    uint64_t context;
+    uint64_t feedback;
+    uint64_t scalingTable;
+};
+
+inline DecodeFrameBuffers makeDecodeFrameBuffers(uint64_t scratchMc) {
+    return {
+        scratchMc + kDecodeFrameMessageOffset,
+        scratchMc + kDecodeFrameDpbOffset,
+        scratchMc + kDecodeFrameTargetOffset,
+        scratchMc + kDecodeFrameSessionContextOffset,
+        scratchMc + kDecodeFrameBitstreamOffset,
+        scratchMc + kDecodeFrameContextOffset,
+        scratchMc + kDecodeFrameFeedbackOffset,
+        scratchMc + kDecodeFrameScalingTableOffset
+    };
+}
+
+// Firmware reads the buffer addresses as high dword followed by low dword.
+inline void writeDecodeAddress(uint32_t *words, uint64_t mc) {
+    words[0] = static_cast<uint32_t>(mc >> 32);
+    words[1] = static_cast<uint32_t>(mc);
+}
+
+// libdrm tests/amdgpu/vcn_tests.c, rvcn_decode_buffer_s and vcn_dec_cmd.
+// Optional session context is used by both session management IBs of the libdrm frame test.
+inline uint32_t buildDecodeIb(uint32_t *words, uint64_t msgMc, uint64_t sessionMc,
+                              const DecodeFrameBuffers *frame) {
+    const uint32_t payloadDw = kDecodeIbDw - 4u;
+    for (uint32_t i = 0; i < kDecodeIbDw; ++i)
+        words[i] = 0;
+    words[0] = 16;
+    words[1] = 0x30000002; // single queue checksum
+    words[3] = payloadDw;
+    words[4] = 16;
+    words[5] = 0x30000001; // engine info
+    words[6] = 3; // decode
+    words[7] = payloadDw * sizeof(uint32_t);
+    words[8] = (kDecodeIbDw - 8u) * sizeof(uint32_t);
+    words[9] = 1;  // DECODE_IB_PARAM_DECODE_BUFFER
+    words[10] = 1; // MSG_BUFFER
+    writeDecodeAddress(words + 11, msgMc);
+    if (sessionMc) {
+        words[10] |= 0x00100000; // SESSION_CONTEXT_BUFFER
+        writeDecodeAddress(words + 17, sessionMc);
+    }
+    if (frame) {
+        words[10] |= 0x00000a1e; // DPB, bitstream, target, feedback, IT scaling and decoder context
+        writeDecodeAddress(words + 13, frame->dpb);
+        writeDecodeAddress(words + 15, frame->target);
+        writeDecodeAddress(words + 19, frame->bitstream);
+        writeDecodeAddress(words + 21, frame->context);
+        writeDecodeAddress(words + 23, frame->feedback);
+        writeDecodeAddress(words + 31, frame->scalingTable);
+    }
+    for (uint32_t i = 4; i < kDecodeIbDw; ++i)
+        words[2] += words[i];
+    return kDecodeIbDw;
+}
+
+inline uint32_t buildDecodeSessionIb(uint32_t *words, uint64_t msgMc, uint64_t sessionMc = 0) {
+    return buildDecodeIb(words, msgMc, sessionMc, nullptr);
+}
+
+inline uint32_t buildDecodeFrameIb(uint32_t *words, const DecodeFrameBuffers &buffers) {
+    return buildDecodeIb(words, buffers.message, buffers.sessionContext, &buffers);
+}
+
+} // namespace phx_vcn
