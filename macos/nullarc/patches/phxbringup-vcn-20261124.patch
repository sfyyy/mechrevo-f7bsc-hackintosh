+    CHECK_EQ(codec[83], 4u);
+    CHECK_EQ(codec[84], 2u);
+    CHECK_EQ(codec[85], 2u);
+    CHECK_EQ(codec[116], 0u);
+    CHECK_EQ(codec[117], 1u);
