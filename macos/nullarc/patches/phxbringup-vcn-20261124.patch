+    CHECK(!isDecodeReferenceIDR(idr, sizeof(idr) - 1));
+    CHECK(!isDecodeReferenceIDR(kDecodeH264Bitstream, sizeof(kDecodeH264Bitstream)));
+    idr[sizeof(idr) - 1] ^= 1;
