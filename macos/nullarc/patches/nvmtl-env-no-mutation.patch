+/*
+ * Keep nvrm610.conf out of the host process environment.
+ *
+ * Metal plugins are loaded lazily, after the host application has already
+ * started.  Calling setenv()/unsetenv() here can reallocate or shorten
+ * environ, invalidating a host that cached the previous pointer and length.
+ * Ghostty 1.4.0 does exactly that and then crashes while building the child
+ * terminal environment.  Resolve driver knobs through this read-only wrapper
+ * instead; an explicitly set process variable still wins over the file.
+ */
+#define NVMTL_CONF_MAX 128
+typedef struct {
+    char *key;
+    char *value;
+} nvmtl_conf_entry;
+static nvmtl_conf_entry g_nvmtl_conf[NVMTL_CONF_MAX];
+static size_t g_nvmtl_conf_count;
+static pthread_once_t g_nvmtl_conf_once = PTHREAD_ONCE_INIT;
+
+static int nvmtl_conf_wanted(const char *key) {
+    return key &&
+        (!strncmp(key, "NVMTL_", 6) || !strncmp(key, "NVK_", 4) ||
+         !strncmp(key, "NAK_", 4) || !strncmp(key, "NVRM_", 5));
+}
+
+static void nvmtl_conf_load(void) {
+    FILE *f = fopen("/Library/GPUBundles/nvmtl/nvrm610.conf", "r");
+    if (!f) return;
+
+    char line[512];
+    while (fgets(line, sizeof line, f)) {
+        char *p = line;
+        while (*p == ' ' || *p == '\t') p++;
+        if (*p == '#' || *p == '\n' || !*p) continue;
+
+        char *eq = strchr(p, '=');
+        if (!eq) continue;
+        *eq = 0;
+        char *key = p;
+        char *val = eq + 1;
+
+        char *end = key + strlen(key);
+        while (end > key && (end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+        end = val + strlen(val);
+        while (end > val && (end[-1] == '\n' || end[-1] == '\r' ||
+                             end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+
+        if (!nvmtl_conf_wanted(key) || !strcmp(key, "NVMTL_CONF_SET")) continue;
+        if (g_nvmtl_conf_count >= NVMTL_CONF_MAX) {
+            syslog(LOG_WARNING, "NullMoth: conf: too many knobs in nvrm610.conf, ignoring the rest");
+            break;
+        }
+
+        char *copy_key = strdup(key);
+        char *copy_val = strdup(val);
+        if (!copy_key || !copy_val) {
+            free(copy_key);
+            free(copy_val);
+            continue;
+        }
+        g_nvmtl_conf[g_nvmtl_conf_count++] = (nvmtl_conf_entry){
+            .key = copy_key,
+            .value = copy_val,
+        };
+    }
+    fclose(f);
+}
+
+/* Read the real process environment only.  Later code uses this for variables
+ * that an external library must see, rather than the plugin's config overlay. */
+static const char *nvmtl_process_getenv(const char *name) {
+    return name ? getenv(name) : NULL;
+}
+
+const char *nvmtl_env_get(const char *name) {
+    if (!name || !*name) return NULL;
+
+    const char *current = getenv(name);
+    if (current) return current;
+    if (!strcmp(name, "NVMTL_CONF_SET")) return NULL;
+
+    pthread_once(&g_nvmtl_conf_once, nvmtl_conf_load);
+    for (size_t i = 0; i < g_nvmtl_conf_count; i++) {
+        if (!strcmp(name, g_nvmtl_conf[i].key)) return g_nvmtl_conf[i].value;
+    }
+    return NULL;
+}
+
+/* All plugin source is one translation unit, so this also covers the included
+ * NVMTL*.m and nvmtl_vk.c files.  Config propagation must not touch the host
+ * process environment; the Chrome/ANGLE override below is the sole exception. */
+#define getenv(name) nvmtl_env_get(name)
+
 #ifndef NVMTL_RELEASE
 #define NVMTL_RELEASE 0
 #endif
