+IOReturn IOAccelPhxNativeClient::doEncodeH264(IOExternalMethodArguments *a) {
+    IOMemoryDescriptor *input = a->structureInputDescriptor;
+    IOMemoryDescriptor *output = a->structureOutputDescriptor;
+    // Both fixed buffers are larger than IOKit's in-band limit. Only the published
+    // out-of-line length is copied back by IOConnectCallStructMethod.
+    const uint32_t capacity = a->structureOutputDescriptorSize;
+    const uint32_t inlineCapacity = a->structureOutputSize;
+    a->structureOutputDescriptorSize = 0;
+    a->structureOutputSize = 0;
+    if (a->asyncReferenceCount || a->structureVariableOutputData || a->scalarInputCount ||
+        a->scalarOutputCount || a->structureInputSize || inlineCapacity ||
+        !input || input->getLength() != PHXN_VCN_NV12_BYTES ||
+        !output || output->getLength() != PHXN_VCN_H264_CAPACITY || capacity != PHXN_VCN_H264_CAPACITY)
+        return kIOReturnBadArgument;
+
+    static_assert(PHXN_VCN_NV12_BYTES >= PHXN_VCN_H264_CAPACITY, "staging buffer must fit encoder output");
+    uint8_t *staging = static_cast<uint8_t *>(IOMalloc(PHXN_VCN_NV12_BYTES));
+    if (!staging)
+        return kIOReturnNoMemory;
+    IOReturn r = input->prepare();
+    if (r == kIOReturnSuccess) {
+        IOByteCount copied = input->readBytes(0, staging, PHXN_VCN_NV12_BYTES);
+        r = input->complete();
+        if (copied != PHXN_VCN_NV12_BYTES)
+            r = kIOReturnVMError;
+    }
+    uint64_t result[8];
+    if (r == kIOReturnSuccess) {
+        // Once the packed pixels have been copied to the device the same private
+        // buffer can receive the stream. Never expose it until close also succeeds.
+        r = owner->vcnCodecFrame(true, staging, capacity, result, staging);
+        if (r == kIOReturnSuccess && result[0] != PHX_VCN_OK)
+            r = (result[0] == PHX_VCN_NOT_READY || result[0] == PHX_VCN_FRAME_REGION)
+                ? kIOReturnNotReady : kIOReturnIOError;
+        if (r == kIOReturnSuccess && (!result[6] || result[6] > capacity))
+            r = kIOReturnIOError;
+    }
+    if (r == kIOReturnSuccess)
+        r = output->prepare();
+    if (r == kIOReturnSuccess) {
+        const uint32_t size = static_cast<uint32_t>(result[6]);
+        IOByteCount copied = output->writeBytes(0, staging, size);
+        r = output->complete();
+        if (copied != size)
+            r = kIOReturnVMError;
+        if (r == kIOReturnSuccess)
+            a->structureOutputDescriptorSize = size;
+    }
+    IOFree(staging, PHXN_VCN_NV12_BYTES);
+    return r;
+}
