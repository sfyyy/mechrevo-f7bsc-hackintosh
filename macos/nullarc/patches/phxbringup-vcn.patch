+# VCN 4.0.2 register fixture, copied from the upstream Linux headers:
+#   drivers/gpu/drm/amd/include/asic_reg/vcn/vcn_4_0_0_offset.h
+#   drivers/gpu/drm/amd/include/asic_reg/vcn/vcn_4_0_0_sh_mask.h
