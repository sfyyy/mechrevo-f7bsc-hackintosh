+// f7bsc capture-nowait: whether surf is one of SkyLight's "Selective Sharing" pool surfaces, in WindowServer only. That
+// pool is the destination of the second, capture-only composite ScreenCaptureKit makes WindowServer draw every frame
+// (WSSelectiveSharingUpdateDisplayStreamSurface). Nothing scans it out and no other process reads it: the next step,
+// DisplayStreamStateMetal::CopyFrame, copies it on the GPU into the client's DisplayStream buffer, and that command
+// buffer is the one that waits and is published. Every Metal queue of a process shares one Vulkan queue, so the copy
+// executes after the composite. With WindowServer's own composite waits on (NVMTL_WS_WAIT_COMPLETION=1, the B-58
+// workaround) and NVMTL_SCHEDULE_AFTER_SURFACE_WRITES=1, waiting for this composite cost ~4 ms of the main thread per
+// captured frame: capture ran at every other vsync (17-19 fps for 25 asked) and the display itself dropped from 60 to
+// ~40 fps (2026-11-20). For these surfaces neither wait is taken. NVMTL_WS_CAPTURE_WAIT=1 restores both.
+static BOOL nvmtl_ws_capture_surface(IOSurfaceRef surf) {
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("NVMTL_WS_CAPTURE_WAIT");
+        on = getprogname() && !strcmp(getprogname(), "WindowServer") && !(e && e[0] == '1');
+    }
+    if (!on || !surf) return NO;
+    CFTypeRef name = IOSurfaceCopyValue(surf, CFSTR("IOSurfaceName"));
+    const BOOL isString = name && CFGetTypeID(name) == CFStringGetTypeID();
+    // SkyLight names its pool surfaces "SL.<pid>:<name>" (seen: "SL.201:Selective Sharing"); accept the bare name too.
+    const BOOL capture = isString && (CFEqual(name, CFSTR("Selective Sharing")) ||
+                                      CFStringHasSuffix((CFStringRef)name, CFSTR(":Selective Sharing")));
+    static NSMutableSet *seen;   // each distinct surface name once, to confirm what WindowServer draws into
+    NSString *ns = isString ? (__bridge NSString *)name : @"(none)";
+    @synchronized ([NVMTLQueueReservation class]) {
+        if (!seen) seen = [NSMutableSet new];
+        if (seen.count < 32 && ![seen containsObject:ns]) {
+            [seen addObject:ns];
+            nvlog("capture-nowait: WindowServer writes surface %u named '%s'%s", IOSurfaceGetID(surf), ns.UTF8String,
+                  capture ? " -> capture composite, no completion wait" : "");
+        }
+    }
+    if (name) CFRelease(name);
+    return capture;
+}
