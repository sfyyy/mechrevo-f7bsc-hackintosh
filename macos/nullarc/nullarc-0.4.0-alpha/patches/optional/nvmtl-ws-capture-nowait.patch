+// f7bsc capture-nowait (see nvmtl_ws_capture_surface in NVMTLEventSync.m): a WindowServer command buffer whose only
+// IOSurface writes go to SkyLight's "Selective Sharing" capture pool does not wait for the GPU here.
+static BOOL nvmtl_cb_writes_only_capture_surfaces(NVMTLCommandBuffer *cb) {
+    BOOL any = NO;
+    for (NVMTLSubmissionPart *part in cb->_parts) {
+        if (![part isKindOfClass:[NVMTLSubmissionPart class]]) continue;
+        for (NVMTLTexture *t in part->surfaces) {
+            if (!t->_surf) continue;
+            if (!nvmtl_ws_capture_surface(t->_surf)) return NO;
+            any = YES;
+        }
+    }
+    return any;
+}
+// f7bsc NVMTL_WS_GPUTIME=1: where WindowServer's blocking composite waits go. For each command buffer waited for in
+// commitAndWaitUntilSubmitted: commit -> submitted to Vulkan (plugin CPU), submitted -> GPU start (queued behind other
+// work: the GFX queue is shared by every process), GPU running, GPU end -> completion seen, seen -> waiter woken.
+// Logged every 2 s as average / max in microseconds.
+static void nvmtl_ws_waitstat(double t0, NVMTLCommandBuffer *cb) {
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_WS_GPUTIME"); on = e && e[0] == '1'; }
+    if (!on) return;
+    const double t1 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1e9;
+    const double ks = [cb kernelStartTime], ke = [cb kernelEndTime], gs = cb.GPUStartTime, ge = cb.GPUEndTime;
+    if (!ks || !ke || !gs || ge < gs) return;
+    const double v[6] = { ks - t0, gs - ks, ge - gs, ke - ge, t1 - ke, t1 - t0 };
+    static double sum[6], mx[6], last; static unsigned n;
+    for (int i = 0; i < 6; i++) { sum[i] += v[i]; if (v[i] > mx[i]) mx[i] = v[i]; }
+    n++;
+    if (!last) last = t1;
+    if (t1 - last < 2.0) return;
+    // Straight to the log file: nvlog keeps only every Nth line of a call site after the first few.
+    FILE *f = fopen(nvmtl_log_path(), "a");
+    if (f) fprintf(f, "pid %d NVMTL: WS wait x%u (avg/max us): submit %.0f/%.0f queued %.0f/%.0f run %.0f/%.0f seen %.0f/%.0f woke %.0f/%.0f total %.0f/%.0f\n",
+          getpid(), n, sum[0]/n*1e6, mx[0]*1e6, sum[1]/n*1e6, mx[1]*1e6, sum[2]/n*1e6, mx[2]*1e6, sum[3]/n*1e6, mx[3]*1e6,
+          sum[4]/n*1e6, mx[4]*1e6, sum[5]/n*1e6, mx[5]*1e6);
+    if (f) fclose(f);
+    memset(sum, 0, sizeof sum); memset(mx, 0, sizeof mx); n = 0; last = t1;
 }
